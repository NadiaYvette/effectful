packages:
  effectful-core/*.cabal
  effectful-plugin/*.cabal
  effectful-th/*.cabal
  effectful/*.cabal

source-repository-package
  type: git
  location: https://github.com/NadiaYvette/polytropos.git
  tag: f35f551236643e5799edeb7f4ff58c9ea09354fe
  subdir:
    packages/polytropos-core
    packages/polytropos-plugin
    packages/polytropos-reader-soup

-- Ignore dependency bounds of other effect libraries.
allow-newer: cleff:*
           , freer-simple:*
           , fused-effects:*
           , polysemy:*
